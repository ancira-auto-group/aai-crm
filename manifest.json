{
  "manifest_version": 3,
  "name": "AAI for CRM - Text Enhancement",
  "version": "2.0.1",
  "description": "Enhance text on VinSolutions CRM pages using AI-powered suggestions",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vinsolutions.com/*",
        "*://*.vinsolutions.app.coxautoinc.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
