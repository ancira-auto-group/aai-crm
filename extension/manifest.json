{
  "manifest_version": 3,
  "name": "AAI for CRM - Text Enhancement",
  "version": "3.1.0",
  "description": "Enhance text on VinSolutions CRM pages using AI-powered suggestions",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vinsolutions.com/*",
        "*://*.vinsolutions.app.coxautoinc.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "enhance-selection": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Enhance the selected text"
    },
    "reply-to-selection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Suggest a response to the selected message"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
